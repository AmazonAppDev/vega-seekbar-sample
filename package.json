    "lint": "eslint src test --ext .ts,.tsx",
    "lint:fix": "eslint src test --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release build:debug",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app"
  },
  "dependencies": {
    "@amazon-devices/kepler-ui-components": "^3.1.0",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-screens": "~3.0.0",
    "@amazon-devices/react-navigation__native": "~8.0.0",
    "@amazon-devices/react-navigation__stack": "~8.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^29.6.3",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.8.3"
  },
  "npm-pretty-much": {
    "runRelease": "always"
  },
  "engines": {
    "node": ">=22.14.0"
  },
